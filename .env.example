DATABASE_URL=postgresql://username:password@localhost:5432/ticket_tech_titan
# If using docker compose: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_tech_titan
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
MODEL_NAME=claude-sonnet-4-6

# Bring your own model instead (see "Using other models" in the README): set
# LLM_PROVIDER=openai, put that provider's key in OPENAI_API_KEY, change
# MODEL_NAME above to one of its models, and for anything but OpenAI itself
# uncomment the matching LLM_BASE_URL.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-provider-api-key
# Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Ollama (local; any placeholder works as OPENAI_API_KEY):
# LLM_BASE_URL=http://localhost:11434/v1

# Price MODEL_NAME for the cost view when it isn't in config/settings.py's
# MODEL_PRICES table. USD per million tokens; both must be set to take effect.
# Set both to 0 for a free local model.
# PRICE_PER_MTOK_INPUT=3.00
# PRICE_PER_MTOK_OUTPUT=15.00
