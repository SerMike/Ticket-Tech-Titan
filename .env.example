DATABASE_URL=postgresql://username:password@localhost:5432/ticket_tech_titan
# If using docker compose: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_tech_titan
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
MODEL_NAME=claude-sonnet-4-6
# Price MODEL_NAME for the cost view when it isn't in config/settings.py's
# MODEL_PRICES table. USD per million tokens; both must be set to take effect.
